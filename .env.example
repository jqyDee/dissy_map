# Copy to .env and fill in YOUR OWN student id. .env is gitignored (personal).
#
# One submission per team, but each member packages the chosen solution under
# their own credentials. MATRIKEL is the id exactly as it must appear in the
# submission filenames, e.g. exc01_source_<MATRIKEL>.zip  ->  exc01_source_cs123456.zip
#
# Store it verbatim, including the "cs" prefix shown in the assignment (csXXXXXX).
MATRIKEL=csXXXXXX
