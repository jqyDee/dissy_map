# Copy to .env and fill in YOUR OWN UIBK username. .env is gitignored (personal).
#
# One submission per team, but each member packages the chosen solution under
# their own credentials. STUDENT_ID is the id exactly as it must appear in the
# submission filenames, e.g. exc01_source_<STUDENT_ID>.zip -> exc01_source_csXXXXXX.zip
#
# This is your UIBK username (the csXXXXXX login), NOT your Matrikelnummer.
STUDENT_ID=csXXXXXX
